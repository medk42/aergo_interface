<?document type="cbunxml" version="1.0" ?>
<bundle name="cbun_aergo_adapter" version="0.1.0" path="libaergo_adapter">
    <label>Aergo Adapter</label>
    <author>Jakub Medek</author>
    <description>CBun for connecting to the Aergo AR robot programming project.</description>
    <class name="aergo::AergoConnector"
        base="kr2_bundle_api::CustomDevice"
        instance_prefix="AERGO" >
        <label>Aergo Connector</label>
        <description>Provides support for connecting to the Aergo AR robot programming project. Creates a server running on the robot for remote control from the Aergo project via a Kassow robot plugin.</description>
        <include>aergo/aergo_adapter.h</include>
        <config>
            <param name="server_port" type="int">
                <label>Server Port</label>
                <default>15050</default>
            </param>
        </config>
    </class>
</bundle>