{
    "version": "0.2.0",
    "configurations": [
        {
          "name": "CBun: Run Active File",
          "type": "cppdbg",
          "request": "launch",
          "program": "${fileDirname}/../../output/tests/${fileBasenameNoExtension}",
          "args": [],
          "stopAtEntry": false,
          "cwd": "${workspaceFolder}",
          "environment": [],
          "externalConsole": false, //set to true to see output in cmd instead
          "MIMode": "gdb",
          "miDebuggerPath": "/usr/bin/gdb",
          "setupCommands": [
            {
              "description": "Enable pretty-printing for gdb",
              "text": "-enable-pretty-printing",
              "ignoreFailures": true
            }
          ],
          "preLaunchTask": "CBun: Build & Install"
      }
    ]
}
